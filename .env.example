# Optional. Copy to .env; existing shell variables take precedence.
GEMINI_API_KEY=
# Set a verified model ID to enable Gemini handwriting OCR.
GEMINI_MODEL=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# A private random secret is required when DJANGO_DEBUG=false.
# DJANGO_SECRET_KEY=
DJANGO_SECURE_COOKIES=true
# Optional absolute paths for a nonstandard Tesseract install.
# TESSERACT_CMD=
# TESSDATA_PREFIX=
# Optional local checkpoint directory; required unless in a launcher-discovered location.
# SMARTDOC_HANDWRITING_MODEL_PATH=
# SMARTDOC_HANDWRITING_DEVICE=cpu
# SMARTDOC_HANDWRITING_NORMALIZE=false
